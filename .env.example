# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Groq Cloud API Key (Free Llama 3.3 70B from https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Key (Optional from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Automatic Telegram Bot Daemon Startup (true/false)
START_BOT=true

# Supabase Authentication & PostgreSQL Database
# Get these from your Supabase Project Settings -> API (https://supabase.com/dashboard)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# Service URLs
API_BASE_URL=http://localhost:8000
QDRANT_URL=http://localhost:6333
