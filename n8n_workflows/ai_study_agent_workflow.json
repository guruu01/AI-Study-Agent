                "conditions": [
                  {
                    "leftValue": "={{ $json.callback_query ? 'callback' : ($json.message?.text?.split(' ')[0] || ($json.message?.document ? 'document' : 'start')) }}",
                    "rightValue": "callback",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Answer Callback"
