        "options": {}
      },
      "id": "e4a7d32a-eeee-4444-9999-000000000014",
      "name": "Chapter Summary API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        780,
        880
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "=📖 *CHAPTER SUMMARY: {{ $json.topic }}*\n\n{{ $json.summary }}\n\n📚 *Sources Cited:* {{ $json.sources.join(', ') }}",
        "additionalFields": {}
      },
      "id": "e4a7d32a-ffff-4444-9999-000000000015",
      "name": "Send Chapter Summary",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1040,
        880
      ],
      "credentials": {
        "telegramApi": {
          "id": "genpfqEyk7eZyRT1",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "chatId": "={{ $json.message.chat.id }}",
        "text": "=👋 *Welcome to your AI Study Agent!*\n\nI turn your uploaded study materials into active recall tools and quiz you right here in Telegram.\n\n📚 *What I Can Do:*\n• 📝 `/quiz [topic]` - Take a grounded multiple-choice quiz\n• 📖 `/summary [chapter]` - Get an executive chapter summary\n• 💡 `/explain [concept]` - ELI5 simple explanation with analogies\n• 📇 `/flashcards [topic]` - Generate active recall flashcards\n• 📊 `/score` - Track your accuracy and progress\n• 🔍 `/revise` - Diagnose weak topics and generate a revision plan\n\n📁 *Drop any document (PDF, Word, PPT, Excel, image, or voice note) to add it to your knowledge vault!*",
        "replyMarkup": "inlineKeyboard",
        "inlineKeyboard": {
          "rows": [
            {
              "row": {
                "buttons": [
                  {
                    "text": "🎯 Start Agile Quiz",
                    "additionalFields": {
                      "callback_data": "cmd:quiz"
                    }
                  },
                  {
                    "text": "📊 My Scorecard",
                    "additionalFields": {
                      "callback_data": "cmd:score"
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      "id": "e4a7d32a-0000-4444-9999-000000000016",
      "name": "Send Welcome Menu",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        780,
        1060
      ],
      "credentials": {
        "telegramApi": {
          "id": "genpfqEyk7eZyRT1",
          "name": "Telegram account"
        }
      }
    }
