      "id": "e4a7d32a-2222-4444-9999-000000000002",
      "name": "Route Command",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.1,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8000/api/quiz",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "user_id",
              "value": "={{ $json.message?.from?.id?.toString() || 'student' }}"
            },
            {
              "name": "topic",
              "value": "={{ $json.message?.text?.replace('/quiz', '')?.trim() || null }}"
            }
          ]
        },
        "options": {}
      },
      "id": "e4a7d32a-3333-4444-9999-000000000003",
      "name": "Generate Grounded Quiz",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        780,
        140
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "=🎯 *Topic: {{ $json.topic }}*\n\n❓ *Question:* {{ $json.question }}\n\n🅰️ *A.* {{ $json.options.A }}\n\n🅱️ *B.* {{ $json.options.B }}\n\n🅲 *C.* {{ $json.options.C }}\n\n🅳 *D.* {{ $json.options.D }}\n\n_Tap your answer below:_ 👇",
        "replyMarkup": "inlineKeyboard",
        "inlineKeyboard": {
          "rows": [
            {
              "row": {
                "buttons": [
                  {
                    "text": "🅰️ Option A",
                    "additionalFields": {
                      "callback_data": "=ans:{{ $json.quiz_id }}:A"
                    }
                  },
                  {
                    "text": "🅱️ Option B",
                    "additionalFields": {
                      "callback_data": "=ans:{{ $json.quiz_id }}:B"
                    }
                  }
                ]
              }
            },
            {
              "row": {
                "buttons": [
                  {
                    "text": "🅲 Option C",
                    "additionalFields": {
                      "callback_data": "=ans:{{ $json.quiz_id }}:C"
                    }
                  },
                  {
                    "text": "🅳 Option D",
                    "additionalFields": {
                      "callback_data": "=ans:{{ $json.quiz_id }}:D"
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      "id": "e4a7d32a-4444-4444-9999-000000000004",
      "name": "Send Telegram Quiz",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1040,
        140
      ],
      "credentials": {
        "telegramApi": {
          "id": "genpfqEyk7eZyRT1",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const cb = $json.callback_query.data;\nconst parts = cb.split(':');\nreturn {\n  json: {\n    chat_id: $json.callback_query.message.chat.id,\n    user_id: $json.callback_query.from.id.toString(),\n    quiz_id: parts[1],\n    selected_option: parts[2]\n  }\n};"
      },
      "id": "e4a7d32a-5555-4444-9999-000000000005",
      "name": "Parse Answer Callback",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        -60
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8000/api/answer",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "quiz_id",
              "value": "={{ $json.quiz_id }}"
            },
            {
              "name": "user_id",
              "value": "={{ $json.user_id }}"
            },
            {
              "name": "selected_option",
              "value": "={{ $json.selected_option }}"
            }
          ]
        },
        "options": {}
      },
      "id": "e4a7d32a-6666-4444-9999-000000000006",
      "name": "Evaluate Answer API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1040,
        -60
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $('Parse Answer Callback').item.json.chat_id }}",
        "text": "={{ $json.is_correct ? '🎉 *CORRECT!* Well done! ✅' : ('❌ *INCORRECT!* The correct answer is *' + $json.correct_option + '* 📌') }}\n\n💡 *Explanation:*\n{{ $json.explanation }}\n\n📖 *Grounded in Your Notes:*\n_{{ $json.source_citation }}_\n\n───────────────\n📊 *Your Overall Score:* {{ $json.user_stats.accuracy_pct }}% ({{ $json.user_stats.correct_answers }}/{{ $json.user_stats.total_quizzes }} correct)",
        "replyMarkup": "inlineKeyboard",
        "inlineKeyboard": {
          "rows": [
            {
              "row": {
                "buttons": [
                  {
                    "text": "Next Question ➡️",
                    "additionalFields": {
                      "callback_data": "cmd:quiz"
                    }
                  },
                  {
                    "text": "Revision Plan 🔍",
                    "additionalFields": {
                      "callback_data": "cmd:revise"
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      "id": "e4a7d32a-7777-4444-9999-000000000007",
      "name": "Send Answer Feedback",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1300,
        -60
      ],
      "credentials": {
        "telegramApi": {
          "id": "genpfqEyk7eZyRT1",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "url": "=http://host.docker.internal:8000/api/progress?user_id={{ $json.message.from.id }}",
        "options": {}
      },
      "id": "e4a7d32a-8888-4444-9999-000000000008",
      "name": "Get Progress API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        780,
        340
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "=📊 *YOUR STUDY SCORECARD*\n\n🎯 *Total Questions:* {{ $json.total_quizzes }}\n✅ *Correct Answers:* {{ $json.correct_answers }}\n📈 *Overall Accuracy:* {{ $json.accuracy_pct }}%\n\n📌 *Topic Breakdown:*\n{{ $json.topic_breakdown.map(t => '• *' + t.topic + ':* ' + t.accuracy + '% (' + t.correct + '/' + t.attempts + ') - ' + t.status).join('\\n') || 'No quizzes completed yet!' }}\n\nUse /quiz to practice or /revise to review weak spots! 🚀",
        "additionalFields": {}
      },
      "id": "e4a7d32a-9999-4444-9999-000000000009",
      "name": "Send Scoreboard",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1040,
        340
      ],
      "credentials": {
        "telegramApi": {
          "id": "genpfqEyk7eZyRT1",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "url": "=http://host.docker.internal:8000/api/revise?user_id={{ $json.message.from.id }}",
        "options": {}
      },
      "id": "e4a7d32a-aaaa-4444-9999-000000000010",
      "name": "Get Revision Plan API",
      "type": "n8n-nodes-base.httpRequest",
