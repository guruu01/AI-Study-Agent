        "additionalFields": {}
      },
      "id": "e4a7d32a-bbbb-4444-9999-000000000011",
      "name": "Send Revision Plan",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1040,
